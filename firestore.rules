rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules, then Publish.
// Anyone can READ the site content (it's shown on the public website).
// Only the Google accounts listed in isOwner() can CHANGE it.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'calsperfectionaquatics@gmail.com'
          // add another Google account here (in quotes, comma before it) to give it access
        ];
    }

    match /site/{docId} {
      allow read: if docId in ['settings', 'availability'];
      allow write: if isOwner()
        && docId in ['settings', 'availability']
        && request.resource.data.size() < 20;  // sanity check on top-level fields
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
